# Neon Postgres connection string (get from https://console.neon.tech)
# Use the "pooled" connection string for DATABASE_URL and the "direct" one for migrations if Neon gives you both.
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/patient_registration?sslmode=require"

# Server
PORT=3000
NODE_ENV=development

# Comma-separated origins allowed to call this API cross-origin (the frontend dashboard).
# Defaults to Vite's dev server on :5173 if unset - only needed if the frontend isn't going
# through the Vite proxy (e.g. VITE_API_BASE_URL points here directly, or a deployed frontend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vapi (voice AI provider) - https://vapi.ai
VAPI_API_KEY=""
# Shared secret Vapi sends back on webhook requests so we can verify authenticity.
VAPI_WEBHOOK_SECRET=""
