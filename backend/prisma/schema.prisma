// Prisma schema for the Voice AI Patient Registration System.
// Target: Neon (serverless Postgres, free tier) - chosen so patient data survives
// server restarts without us managing a local volume.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
  OTHER
  DECLINE_TO_ANSWER
}

model Patient {
  patient_id String @id @default(uuid()) @db.Uuid

  first_name String @db.VarChar(50)
  last_name  String @db.VarChar(50)

  date_of_birth DateTime @db.Date
  sex           Sex

  phone_number String  @db.VarChar(10)
  email        String? @db.VarChar(254)

  address_line_1 String  @db.VarChar(200)
  address_line_2 String? @db.VarChar(200)
  city           String  @db.VarChar(100)
  state          String  @db.Char(2)
  zip_code       String  @db.VarChar(10)

  insurance_provider   String? @db.VarChar(150)
  insurance_member_id  String? @db.VarChar(50)
  preferred_language   String  @default("English") @db.VarChar(50)

  emergency_contact_name  String? @db.VarChar(100)
  emergency_contact_phone String? @db.VarChar(10)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  transcripts Transcript[]

  // Frequently filtered/looked-up in both the REST API and the voice agent's
  // "is this a returning caller" check, so index them.
  @@index([last_name])
  @@index([phone_number])
  @@index([date_of_birth])
  @@map("patients")
}

// Call transcripts/analytics captured from Vapi's end-of-call-report webhook (see
// voice-service.ts handleEndOfCallReport). patient_id is nullable because a call can end
// before the caller's phone number is known to us (e.g. dropped mid-registration, or the ANI
// didn't match any existing patient) - those are stored as anonymous call records rather than
// dropped, so nothing about a completed call is silently lost.
model Transcript {
  id String @id @default(uuid()) @db.Uuid

  patient_id String? @db.Uuid
  patient    Patient? @relation(fields: [patient_id], references: [patient_id])

  // Unique so a retried/duplicate webhook delivery from Vapi for the same call upserts instead
  // of creating a second row for the same conversation.
  vapi_call_id String @unique @db.VarChar(100)

  summary          String? @db.Text
  transcript_text  String? @db.Text
  recording_url    String? @db.VarChar(500)
  duration_seconds Int?

  created_at DateTime @default(now())

  @@index([patient_id])
  @@map("transcripts")
}
