# Leave unset for local dev - requests stay relative and go through the Vite dev-server proxy
# (vite.config.ts) to the backend on :3000. Set this only when NOT using that proxy (e.g. a
# production build served separately from the API) - the backend must have this origin listed
# in its CORS_ORIGINS for requests to succeed.
# VITE_API_BASE_URL=http://localhost:3000
